insmod part_gpt
insmod part_msdos
insmod fat
insmod iso9660

insmod all_video
insmod font

set default="0"
set timeout=30

menuentry "Tharsis <[European Linux for Defence]> - Live ISO" {
    search --no-floppy --set=root --label @DISK_LABEL@
    linux ($root)/live/vmlinuz quiet boot=live @EXTRA_KARGS@
    initrd ($root)/live/initrd.img
}

menuentry "Tharsis <[European Linux for Defence]> - Live ISO (Basic Graphics Mode)" {
    search --no-floppy --set=root --label @DISK_LABEL@
    linux ($root)/live/vmlinuz quiet boot=live nomodeset @EXTRA_KARGS@
    initrd ($root)/live/initrd.img
}
